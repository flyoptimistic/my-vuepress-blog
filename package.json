{
  "name": "vue-blog",
  "version": "1.0.0",
  "description": "Vuepress 2搭建的个人博客",
  "main": "index.js",
  "scripts": {
    "docs:dev": "NO_UPDATE_NOTIFIER=1 PATH=/usr/local/bin:/opt/homebrew/bin:$PATH vuepress dev docs --open",
    "docs:build": "NO_UPDATE_NOTIFIER=1 PATH=/usr/local/bin:/opt/homebrew/bin:$PATH vuepress build docs",
    "docs:dev-port": "NO_UPDATE_NOTIFIER=1 PATH=/usr/local/bin:/opt/homebrew/bin:$PATH vuepress dev docs --port 9090 --open",
    "new-post": "node create-post.js",
    "upload-images": "node upload-images.js",
    "process-images": "node image-processor.js",
    "scan-images": "node image-processor.js scan",
    "add-image-mapping": "node image-processor.js add",
    "replace-image-links": "node image-processor.js process"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyoptimistic/my-vuepress-blog.git"
  },
  "keywords": [
    "VuePress",
    "blog",
    "博客",
    "Java",
    "高并发",
    "数据库",
    "算法",
    "前端",
    "后端"
  ],
  "author": "北木南",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/flyoptimistic/my-vuepress-blog/issues"
  },
  "homepage": "https://flyoptimistic.github.io/my-vuepress-blog/",
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.9",
    "sass": "^1.91.0",
    "terser": "^5.43.1",
    "vue": "^3.5.20",
    "vuepress": "2.0.0-rc.9",
    "vuepress-theme-hope": "2.0.0-rc.33"
  }
}
