# 图床服务配置环境变量
# 复制此文件为 .env 并填入真实的配置信息

# GitHub 图床配置 (推荐)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=flyoptimistic/blog-images
GITHUB_BRANCH=main

# SM.MS 图床配置 (免费)  
SMMS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 腾讯云 COS 配置
QCLOUD_SECRET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
QCLOUD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx